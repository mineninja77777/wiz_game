
{
    "param_types": {
        "name": "str",
        "hp": "float",
        "max_hp": "float",
        "mana": "float",
        "max_mana": "float"
    },
    "events": {
        "input_name": {
            "function": "random.choice",
            "params": [
                "Hear, adventurer, what doest thou call thyself?",
                "Hark, what is thy name and nomination?"
            ]
        },
        "player_start_turn": "{name}, it is thy turn",
        "select_action": [
            "What action doest though wish to take?\n{actions}"
        ],
        "select_target": [
            "Who wouldst thou like to target with that attack?\n{enemies}"
        ],
        "output_hp": {
            "function": "choose_by_param",
            "params": [
                {
                    "<0.5 * {max_hp}": "You  have low health",
                    "={max_hp}": "you have max health"
                },
                "{hp}"
            ]
        }
    }
}